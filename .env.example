# domain-cert-monitor settings. Copy to .env and adjust: cp .env.example .env

# HTTP port inside the container (also the published host port)
PORT=8080
# Public URL of the app, used in alert email links
BASE_URL=http://localhost:8080
# Hours between full check runs (a float, e.g. 0.01 for testing)
CHECK_INTERVAL_HOURS=6
# Days before expiry at which alerts are sent (comma-separated)
ALERT_THRESHOLDS=30,14,7

# SMTP server for alert emails; alerts are disabled if SMTP_HOST is empty.
# For the bundled Mailpit (docker compose --profile dev up):
#   SMTP_HOST=mailpit  SMTP_PORT=1025  SMTP_SECURITY=none
SMTP_HOST=
# SMTP port (587 for starttls, 465 for tls)
SMTP_PORT=587
# SMTP login user; leave empty to send without authentication
SMTP_USER=
# SMTP login password
SMTP_PASSWORD=
# Connection security: starttls, tls or none
SMTP_SECURITY=starttls
# Sender address of alert emails
SMTP_FROM=
# Alert recipients (comma-separated)
ALERT_TO=

# Display time zone (IANA name, e.g. Europe/Berlin)
TZ=UTC
# Log level: debug, info, warning, error
LOG_LEVEL=info
